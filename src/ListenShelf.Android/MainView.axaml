<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ListenShelf.Android" x:Class="ListenShelf.Android.MainView"
             x:DataType="local:MobileViewModel" Background="#10141F">
  <Grid x:Name="SafeContent" RowDefinitions="Auto,*,Auto,Auto,Auto">
    <Grid Margin="22,14,22,12" ColumnDefinitions="Auto,*,Auto">
      <Image Source="avares://ListenShelf.Android/Assets/listenshelf.png" Width="34" Height="34" Margin="0,0,10,0" />
      <TextBlock Grid.Column="1" Text="ListenShelf" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Border Grid.Column="2" CornerRadius="8" Background="#292541" Padding="9,5" VerticalAlignment="Center">
        <TextBlock Text="PREVIEW" FontSize="10" FontWeight="Bold" Foreground="#B9B1FF" LetterSpacing="1" />
      </Border>
    </Grid>

    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsLibrary}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
      <StackPanel Margin="22,14,22,24" Spacing="20">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="5"><TextBlock Text="Your library" FontSize="30" FontWeight="Bold" /><TextBlock Text="Good stories, always within reach." Classes="muted" FontSize="13" /></StackPanel>
          <Button Grid.Column="1" Content="+ Add" Classes="primary" Command="{Binding ImportCommand}" IsEnabled="{Binding !IsBusy}" VerticalAlignment="Center" />
        </Grid>
        <TextBox Text="{Binding Search}" PlaceholderText="Search your shelf" CornerRadius="14" MinHeight="48" Padding="15,12" />
        <TextBlock Text="{Binding LibraryCount}" FontSize="11" FontWeight="SemiBold" Foreground="#9EA9BC" LetterSpacing="1.8" />
        <Border IsVisible="{Binding IsEmpty}" CornerRadius="24" Background="#181E2C" Padding="24,38">
          <StackPanel Spacing="18" HorizontalAlignment="Center">
            <Border Background="#292541" CornerRadius="24" Width="88" Height="88" HorizontalAlignment="Center">
              <Image Source="avares://ListenShelf.Android/Assets/listenshelf.png" Width="66" Height="66" />
            </Border>
            <TextBlock Text="{Binding EmptyTitle}" FontSize="27" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding EmptyDescription}" Classes="muted" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22" />
            <Button Content="Add an audiobook" Command="{Binding ImportCommand}" Classes="primary" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Center" />
            <TextBlock Text="M4B · M4A · MP3" Foreground="#8C83CB" FontSize="11" TextAlignment="Center" LetterSpacing="2" />
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Books}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:BookItem" x:CompileBindings="False">
              <Button AutomationProperties.Name="{Binding Title}" Command="{Binding $parent[UserControl].DataContext.OpenBookCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="#181E2C" Padding="12" Margin="0,0,0,12" CornerRadius="18" IsEnabled="{Binding !$parent[UserControl].DataContext.IsBusy}">
                <Grid ColumnDefinitions="64,*,Auto">
                  <Border Width="64" Height="78" Background="#302B56" CornerRadius="10" ClipToBounds="True">
                    <Grid><Image Source="avares://ListenShelf.Android/Assets/listenshelf.png" Width="45" Height="45" IsVisible="{Binding !HasCover}" /><Image Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" /></Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0,10,0" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxLines="2" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="›" Foreground="#AFA6FF" FontSize="26" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Your books. Your device. Your own pace." Classes="muted" FontSize="12" TextAlignment="Center" />
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsPlayer}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
      <StackPanel Margin="26,14,26,24" Spacing="20" MaxWidth="600">
        <TextBlock Text="{Binding StateLabel}" TextAlignment="Center" Foreground="#B9B1FF" FontSize="11" FontWeight="SemiBold" LetterSpacing="2" />
        <Border Width="220" Height="220" HorizontalAlignment="Center" CornerRadius="25" Background="#302B56" ClipToBounds="True" BoxShadow="0 12 35 0 #50000000">
          <Grid>
            <StackPanel IsVisible="{Binding !HasCover}" Spacing="12" VerticalAlignment="Center">
              <Image Source="avares://ListenShelf.Android/Assets/listenshelf.png" Width="108" Height="108" />
              <TextBlock Text="A STORY WORTH HEARING" TextAlignment="Center" Foreground="#BDB5ED" FontSize="9" LetterSpacing="1.7" />
            </StackPanel>
            <Image Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
          </Grid>
        </Border>
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" MaxLines="3" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Author}" Classes="muted" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock Text="{Binding ChapterText}" Foreground="#B9B1FF" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding HasChapters}" />
        </StackPanel>
        <StackPanel Spacing="5">
          <Slider x:Name="SeekBar" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}" IsEnabled="{Binding CanControl}" AutomationProperties.Name="Listening position" />
          <Grid ColumnDefinitions="*,*"><TextBlock Text="{Binding PositionText}" Classes="muted" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding DurationText}" Classes="muted" FontSize="12" HorizontalAlignment="Right" /></Grid>
          <TextBlock Text="{Binding RemainingText}" Classes="muted" FontSize="12" TextAlignment="Center" Margin="0,5,0,0" />
        </StackPanel>
        <Grid ColumnDefinitions="*,1.4*,*" ColumnSpacing="12" IsEnabled="{Binding CanControl}">
          <Button Content="{Binding RewindLabel}" Command="{Binding RewindCommand}" Classes="quiet" Padding="4" FontSize="17" />
          <Button Grid.Column="1" Content="{Binding PlayLabel}" Command="{Binding TogglePlaybackCommand}" Classes="primary" FontSize="19" FontWeight="SemiBold" MinHeight="64" CornerRadius="32" HorizontalAlignment="Stretch" />
          <Button Grid.Column="2" Content="{Binding ForwardLabel}" Command="{Binding ForwardCommand}" Classes="quiet" Padding="4" FontSize="17" />
        </Grid>
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" IsEnabled="{Binding CanControl}">
          <Button x:Name="SpeedButton" AutomationProperties.Name="Playback speed" HorizontalAlignment="Stretch"><StackPanel Spacing="4"><TextBlock Text="{Binding SpeedText}" HorizontalAlignment="Center" FontWeight="SemiBold" /><TextBlock Text="Speed" Classes="muted" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
            <Button.Flyout><Flyout><StackPanel Spacing="4" MinWidth="190"><Button Click="CloseOptions" HorizontalAlignment="Stretch" Content="0.75×" Command="{Binding SetSpeedCommand}" CommandParameter="0.75" /><Button Click="CloseOptions" HorizontalAlignment="Stretch" Content="1× · Normal" Command="{Binding SetSpeedCommand}" CommandParameter="1" /><Button Click="CloseOptions" HorizontalAlignment="Stretch" Content="1.25×" Command="{Binding SetSpeedCommand}" CommandParameter="1.25" /><Button Click="CloseOptions" HorizontalAlignment="Stretch" Content="1.5×" Command="{Binding SetSpeedCommand}" CommandParameter="1.5" /><Button Click="CloseOptions" HorizontalAlignment="Stretch" Content="1.75×" Command="{Binding SetSpeedCommand}" CommandParameter="1.75" /><Button Click="CloseOptions" HorizontalAlignment="Stretch" Content="2×" Command="{Binding SetSpeedCommand}" CommandParameter="2" /></StackPanel></Flyout></Button.Flyout>
          </Button>
          <Button Grid.Column="1" x:Name="SleepButton" AutomationProperties.Name="Sleep timer" HorizontalAlignment="Stretch"><StackPanel Spacing="4"><TextBlock Text="{Binding SleepText}" HorizontalAlignment="Center" FontWeight="SemiBold" /><TextBlock Text="Sleep timer" Classes="muted" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
            <Button.Flyout><Flyout><StackPanel Spacing="4" MinWidth="190"><Button Click="CloseOptions" HorizontalAlignment="Stretch" Content="15 minutes" Command="{Binding SetSleepCommand}" CommandParameter="15" /><Button Click="CloseOptions" HorizontalAlignment="Stretch" Content="30 minutes" Command="{Binding SetSleepCommand}" CommandParameter="30" /><Button Click="CloseOptions" HorizontalAlignment="Stretch" Content="45 minutes" Command="{Binding SetSleepCommand}" CommandParameter="45" /><Button Click="CloseOptions" HorizontalAlignment="Stretch" Content="60 minutes" Command="{Binding SetSleepCommand}" CommandParameter="60" /><Button Click="CloseOptions" HorizontalAlignment="Stretch" Content="Cancel timer" Command="{Binding SetSleepCommand}" CommandParameter="0" /></StackPanel></Flyout></Button.Flyout>
          </Button>
          <Button Grid.Column="2" AutomationProperties.Name="Add bookmark" Command="{Binding AddBookmarkCommand}" HorizontalAlignment="Stretch"><StackPanel Spacing="4"><TextBlock Text="+" HorizontalAlignment="Center" FontWeight="SemiBold" /><TextBlock Text="Bookmark" Classes="muted" FontSize="11" HorizontalAlignment="Center" /></StackPanel></Button>
        </Grid>
        <Expander Background="#181E2C" BorderBrush="#252D3C" CornerRadius="12" Header="Chapters" IsVisible="{Binding HasChapters}" HorizontalAlignment="Stretch">
          <ItemsControl ItemsSource="{Binding Chapters}"><ItemsControl.ItemTemplate><DataTemplate x:CompileBindings="False"><Button AutomationProperties.Name="{Binding Title}" Command="{Binding $parent[UserControl].DataContext.GoToChapterCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Classes="quiet"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Text="{Binding Time}" Classes="muted" Margin="12,0,0,0" /></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </Expander>
        <Expander Background="#181E2C" BorderBrush="#252D3C" CornerRadius="12" Header="Bookmarks" IsVisible="{Binding HasBookmarks}" HorizontalAlignment="Stretch">
          <ItemsControl ItemsSource="{Binding Bookmarks}"><ItemsControl.ItemTemplate><DataTemplate x:CompileBindings="False"><Button AutomationProperties.Name="{Binding Title}" Command="{Binding $parent[UserControl].DataContext.GoToBookmarkCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Classes="quiet"><StackPanel Spacing="4"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" /><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </Expander>
        <Button Content="Choose an audiobook" Command="{Binding ShowLibraryCommand}" IsVisible="{Binding !HasBook}" Classes="primary" HorizontalAlignment="Center" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Margin="16,6" Padding="12" Background="#292541" CornerRadius="12" IsVisible="{Binding HasStatus}">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="✕" Command="{Binding DismissStatusCommand}" Classes="quiet" IsVisible="{Binding !IsImporting}" Padding="8" AutomationProperties.Name="Dismiss message" />
        <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelImportCommand}" Classes="quiet" IsVisible="{Binding IsImporting}" Padding="8" />
      </Grid>
    </Border>
    <Border Grid.Row="3" IsVisible="{Binding ShowMiniPlayer}" Background="#242038" CornerRadius="16" Margin="16,6" Padding="14,8">
      <Grid ColumnDefinitions="*,Auto"><Button AutomationProperties.Name="Open player" Command="{Binding ShowPlayerCommand}" Classes="quiet" Padding="0" HorizontalContentAlignment="Left"><StackPanel Spacing="4"><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding PositionText}" Classes="muted" FontSize="11" /></StackPanel></Button><Button Grid.Column="1" Content="{Binding PlayLabel}" Command="{Binding TogglePlaybackCommand}" Classes="primary" IsEnabled="{Binding CanControl}" /></Grid>
    </Border>
    <Border Grid.Row="4" Background="#151A26" BorderBrush="#252D3C" BorderThickness="0,1,0,0" Padding="16,6">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Button Content="Library" Command="{Binding ShowLibraryCommand}" Classes="quiet" Classes.active="{Binding IsLibrary}" HorizontalAlignment="Stretch" />
        <Button Grid.Column="1" Content="Player" Command="{Binding ShowPlayerCommand}" Classes="quiet" Classes.active="{Binding IsPlayer}" HorizontalAlignment="Stretch" />
      </Grid>
    </Border>
  </Grid>
  <UserControl.Styles><Style Selector="Button.active"><Setter Property="Background" Value="#302B56" /><Setter Property="Foreground" Value="#D1CAFF" /></Style></UserControl.Styles>
</UserControl>
