<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ListenShelf.Desktop.ViewModels"
        x:Class="ListenShelf.Desktop.Views.BookRemovalConfirmationWindow"
        x:DataType="vm:BookRemovalConfirmationViewModel"
        Width="520"
        Height="350"
        CanResize="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="/Assets/Branding/listenshelf.ico"
        ShowInTaskbar="False"
        Title="Remove audiobook"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Padding="22,18"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="5">
                <TextBlock FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DangerTextBrush}"
                           Text="PERMANENT REMOVAL" />
                <TextBlock FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Text="{Binding Heading}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="22"
                    Spacing="14">
            <TextBlock FontSize="13"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="ListenShelf will permanently delete its managed audiobook copy, cached cover, metadata, bookmarks, and listening progress."
                       TextWrapping="Wrap" />
            <Border Padding="12,9"
                    CornerRadius="9"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding FileName}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
            <TextBlock FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentTextBrush}"
                       Text="Your original source file will remain untouched."
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="18"
                Background="{DynamicResource FooterBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="10">
                <Button MinWidth="96"
                        Padding="16,9"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Click="Cancel_OnClick"
                        Content="Cancel" />
                <Button MinWidth="164"
                        Padding="16,9"
                        Background="{DynamicResource CoralAccentBrush}"
                        Foreground="{DynamicResource OnAccentBrush}"
                        FontWeight="SemiBold"
                        Click="Remove_OnClick"
                        Content="Delete managed copy" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
