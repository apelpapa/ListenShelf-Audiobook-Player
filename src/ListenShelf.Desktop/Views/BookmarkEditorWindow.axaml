<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ListenShelf.Desktop.ViewModels"
        x:Class="ListenShelf.Desktop.Views.BookmarkEditorWindow"
        x:DataType="vm:BookmarkEditorViewModel"
        Width="520"
        SizeToContent="Height"
        Background="{DynamicResource AppBackgroundBrush}"
        CanResize="False"
        Icon="/Assets/Branding/listenshelf.ico"
        ShowInTaskbar="False"
        Title="{Binding WindowTitle}"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,Auto,Auto">
        <Border Grid.Row="0"
                Padding="24,20"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Text="{Binding Heading}" />
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding Description}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="24"
                    Spacing="15">
            <StackPanel Spacing="5">
                <TextBlock FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Name (optional)" />
                <TextBox MaxLength="120"
                         Background="{DynamicResource SurfaceRaisedBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         CornerRadius="8"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         Text="{Binding Name, Mode=TwoWay}"
                         PlaceholderText="Important scene, character introduction…" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Note (optional)" />
                <TextBox MinHeight="100"
                         MaxHeight="180"
                         MaxLength="2000"
                         AcceptsReturn="True"
                         Background="{DynamicResource SurfaceRaisedBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         CornerRadius="8"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         Text="{Binding Note, Mode=TwoWay}"
                         TextWrapping="Wrap"
                         PlaceholderText="Why do you want to return here?" />
            </StackPanel>

            <TextBlock FontSize="11"
                       Foreground="{DynamicResource SubtleTextBrush}"
                       Text="Bookmarks are stored locally and never modify the audiobook file."
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="24,14"
                Background="{DynamicResource FooterBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="10">
                <Button Padding="18,9"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Click="Cancel_OnClick"
                        Content="Cancel" />
                <Button Padding="18,9"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource OnAccentBrush}"
                        FontWeight="SemiBold"
                        Click="Save_OnClick"
                        Content="{Binding SaveButtonText}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
