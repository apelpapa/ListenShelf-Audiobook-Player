<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ListenShelf.Desktop.ViewModels"
             x:Class="ListenShelf.Desktop.Views.Sections.PlayerView"
             x:DataType="vm:MainWindowViewModel">
    <Grid ColumnDefinitions="0.38*,0.62*" ColumnSpacing="22">
        <Border Grid.Column="0"
                Padding="22"
                CornerRadius="20"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid RowDefinitions="*,Auto">
                <Border Grid.Row="0"
                        MinHeight="240"
                        CornerRadius="17"
                        Background="{DynamicResource ArtworkPlaceholderBrush}"
                        ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding CurrentCoverImage}"
                               Stretch="Uniform"
                               IsVisible="{Binding HasCurrentCover}" />
                        <Border Width="104"
                                Height="104"
                                CornerRadius="52"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentSoftBrush}"
                                IsVisible="{Binding HasNoCurrentCover}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="42"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       Text="♪" />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,21,0,0" Spacing="7">
                    <TextBlock FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding BookTitle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding FileName}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource AccentTextBrush}"
                               Text="{Binding ProgressText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Padding="28"
                CornerRadius="20"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="5">
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="NOW PLAYING" />
                        <TextBlock FontSize="17"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="{Binding StatusText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Border Padding="10,5"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceRaisedBrush}">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{Binding FileFormatText}" />
                        </Border>

                        <Button MinWidth="108"
                                Padding="10,5"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontSize="12"
                                IsEnabled="{Binding IsFileLoaded}"
                                Content="{Binding SleepTimerButtonText}"
                                ToolTip.Tip="{Binding SleepTimerStatusText}">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding SleepTimerStatusText}"
                                              IsEnabled="False" />
                                    <Separator />
                                    <MenuItem Header="15 minutes"
                                              Command="{Binding StartSleepTimer15Command}" />
                                    <MenuItem Header="30 minutes"
                                              Command="{Binding StartSleepTimer30Command}" />
                                    <MenuItem Header="45 minutes"
                                              Command="{Binding StartSleepTimer45Command}" />
                                    <MenuItem Header="60 minutes"
                                              Command="{Binding StartSleepTimer60Command}" />
                                    <MenuItem Header="90 minutes"
                                              Command="{Binding StartSleepTimer90Command}" />
                                    <Separator />
                                    <MenuItem Header="Add 10 minutes"
                                              Command="{Binding AddTenMinutesToSleepTimerCommand}"
                                              IsEnabled="{Binding IsSleepTimerActive}" />
                                    <MenuItem Header="Cancel timer"
                                              Command="{Binding CancelSleepTimerCommand}"
                                              IsEnabled="{Binding IsSleepTimerActive}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            Spacing="22">
                    <StackPanel Spacing="8">
                        <Slider Minimum="0"
                                Maximum="{Binding SeekMaximum}"
                                Value="{Binding PositionSeconds, Mode=TwoWay}"
                                IsEnabled="{Binding CanControlPlayback}" />
                        <Grid ColumnDefinitions="*,Auto,*">
                            <TextBlock Grid.Column="0"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding ElapsedText}" />
                            <TextBlock Grid.Column="1"
                                       FontSize="12"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="{Binding DurationText}" />
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding RemainingText}" />
                        </Grid>
                    </StackPanel>

                    <Border Padding="11,9"
                            CornerRadius="11"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding HasChapters}">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="CHAPTERS" />
                                <TextBlock Grid.Column="1"
                                           FontSize="10"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{Binding ChapterPositionText}" />
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Width="82"
                                        Padding="8,7"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        FontSize="10"
                                        Command="{Binding PreviousChapterCommand}"
                                        Content="← Previous" />
                                <ComboBox Grid.Column="1"
                                          MinWidth="180"
                                          ItemsSource="{Binding Chapters}"
                                          SelectedItem="{Binding SelectedChapter, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlaybackChapterItemViewModel">
                                            <TextBlock Text="{Binding DisplayText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2"
                                        Width="70"
                                        Padding="8,7"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        FontSize="10"
                                        Command="{Binding NextChapterCommand}"
                                        Content="Next →" />
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="14">
                        <Button Width="92"
                                Height="48"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Command="{Binding SkipBackwardCommand}"
                                IsEnabled="{Binding CanControlPlayback}"
                                ToolTip.Tip="Rewind 15 seconds (Left Arrow, J, or Previous media button)"
                                Content="−15 sec" />
                        <Button Width="112"
                                Height="56"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource OnAccentBrush}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Command="{Binding TogglePlaybackCommand}"
                                IsEnabled="{Binding CanControlPlayback}"
                                ToolTip.Tip="Play or pause (Space, K, or Play/Pause media button)"
                                Content="{Binding PlayPauseLabel}" />
                        <Button Width="92"
                                Height="48"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Command="{Binding SkipForwardCommand}"
                                IsEnabled="{Binding CanControlPlayback}"
                                ToolTip.Tip="Forward 30 seconds (Right Arrow, L, or Next media button)"
                                Content="+30 sec" />
                    </StackPanel>

                    <TextBlock MinHeight="20"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource DangerTextBrush}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,150,*,Auto,90">
                    <TextBlock Grid.Column="0"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Volume" />
                    <Slider Grid.Column="1"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding Volume, Mode=TwoWay}" />

                    <TextBlock Grid.Column="3"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Speed" />
                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding PlaybackRates}"
                              SelectedItem="{Binding SelectedPlaybackRate, Mode=TwoWay}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
