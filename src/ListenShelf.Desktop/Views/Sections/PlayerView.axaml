<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ListenShelf.Desktop.ViewModels"
             x:Class="ListenShelf.Desktop.Views.Sections.PlayerView"
             x:DataType="vm:MainWindowViewModel">
    <Grid ColumnDefinitions="0.38*,0.62*" ColumnSpacing="22">
        <Border Grid.Column="0"
                Padding="22"
                CornerRadius="20"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid RowDefinitions="*,Auto">
                <Border Grid.Row="0"
                        MinHeight="240"
                        CornerRadius="17"
                        Background="{DynamicResource ArtworkPlaceholderBrush}"
                        ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding CurrentCoverImage}"
                               Stretch="Uniform"
                               IsVisible="{Binding HasCurrentCover}" />
                        <Border Width="104"
                                Height="104"
                                CornerRadius="52"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentSoftBrush}"
                                IsVisible="{Binding HasNoCurrentCover}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="42"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       Text="♪" />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,21,0,0" Spacing="7">
                    <TextBlock FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding BookTitle}"
                               TextTrimming="CharacterEllipsis">
                        <ToolTip.Tip>
                            <TextBlock MaxWidth="420" TextWrapping="Wrap" Text="{Binding BookTitle}" />
                        </ToolTip.Tip>
                    </TextBlock>
                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding FileName}"
                               TextTrimming="CharacterEllipsis">
                        <ToolTip.Tip>
                            <TextBlock MaxWidth="420" TextWrapping="Wrap" Text="{Binding FileName}" />
                        </ToolTip.Tip>
                    </TextBlock>
                    <TextBlock Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource AccentTextBrush}"
                               Text="{Binding ProgressText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Padding="28"
                CornerRadius="20"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="5">
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="NOW PLAYING" />
                        <TextBlock FontSize="17"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="{Binding StatusText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Border Padding="10,5"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceRaisedBrush}">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{Binding FileFormatText}" />
                        </Border>

                        <Button MinWidth="108"
                                Padding="10,5"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontSize="12"
                                IsEnabled="{Binding IsFileLoaded}"
                                Content="{Binding SleepTimerButtonText}"
                                ToolTip.Tip="{Binding SleepTimerStatusText}">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding SleepTimerStatusText}"
                                              IsEnabled="False" />
                                    <Separator />
                                    <MenuItem Header="{Binding LastSleepTimerMenuText}"
                                              Command="{Binding StartLastSleepTimerCommand}"
                                              ToolTip.Tip="{Binding LastSleepTimerToolTip}" />
                                    <Separator />
                                    <MenuItem Header="Stop at end of chapter"
                                              Command="{Binding StartChapterSleepTimerCommand}" />
                                    <Separator />
                                    <MenuItem Header="15 minutes"
                                              Command="{Binding StartSleepTimer15Command}" />
                                    <MenuItem Header="30 minutes"
                                              Command="{Binding StartSleepTimer30Command}" />
                                    <MenuItem Header="45 minutes"
                                              Command="{Binding StartSleepTimer45Command}" />
                                    <MenuItem Header="60 minutes"
                                              Command="{Binding StartSleepTimer60Command}" />
                                    <MenuItem Header="90 minutes"
                                              Command="{Binding StartSleepTimer90Command}" />
                                    <MenuItem Header="Custom minutes…"
                                              Command="{Binding StartCustomSleepTimerCommand}" />
                                    <Separator />
                                    <MenuItem Header="Add 10 minutes"
                                              Command="{Binding AddTenMinutesToSleepTimerCommand}"
                                              IsEnabled="{Binding CanAddTenMinutesToSleepTimer}" />
                                    <MenuItem Header="Cancel timer"
                                              Command="{Binding CancelSleepTimerCommand}"
                                              IsEnabled="{Binding IsSleepTimerActive}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,14"
                                VerticalAlignment="Center"
                                Spacing="18">
                        <StackPanel Spacing="12" IsVisible="{Binding !IsFileLoaded}">
                            <TextBlock FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Choose an audiobook from your library to begin listening."
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Center"
                                    Padding="18,10"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource OnAccentBrush}"
                                    FontWeight="SemiBold"
                                    Content="Go to library"
                                    Command="{Binding ShowLibraryCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                        <Slider Minimum="0"
                                Maximum="{Binding SeekMaximum}"
                                Value="{Binding PositionSeconds, Mode=TwoWay}"
                                IsEnabled="{Binding CanControlPlayback}" />
                        <Grid ColumnDefinitions="*,Auto,*">
                            <Button Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Padding="0"
                                    MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12"
                                    Foreground="{DynamicResource AccentTextBrush}"
                                    Cursor="Hand"
                                    Command="{Binding JumpToTimeCommand}"
                                    Content="{Binding ElapsedText}"
                                    AutomationProperties.Name="Jump to time"
                                    ToolTip.Tip="Jump to time — enter mm:ss or hh:mm:ss" />
                            <TextBlock Grid.Column="1"
                                       FontSize="12"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="{Binding DurationText}" />
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding RemainingText}" />
                        </Grid>
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding ListeningTimeRemainingText}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding IsFileLoaded}"
                                   ToolTip.Tip="Estimated listening time at the selected playback speed, excluding pauses. The timeline above stays in audiobook time." />
                        </StackPanel>

                    <Border Padding="11,9"
                            CornerRadius="11"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding HasChapters}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="CHAPTERS" />
                                <TextBlock Grid.Column="1"
                                           FontSize="10"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{Binding ChapterPositionText}" />
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Width="82"
                                        Padding="8,7"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        FontSize="10"
                                        Command="{Binding PreviousChapterCommand}"
                                        Content="← Previous" />
                                <ComboBox Grid.Column="1"
                                          MinWidth="180"
                                          ItemsSource="{Binding Chapters}"
                                          SelectedItem="{Binding SelectedChapter, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlaybackChapterItemViewModel">
                                            <TextBlock Text="{Binding DisplayText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2"
                                        Width="70"
                                        Padding="8,7"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        FontSize="10"
                                        Command="{Binding NextChapterCommand}"
                                        Content="Next →" />
                            </Grid>
                            <Expander Grid.Row="2"
                                      Header="Find a chapter"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      IsExpanded="{Binding IsChapterSearchExpanded, Mode=TwoWay}">
                                <Grid RowDefinitions="Auto,Auto,*"
                                      RowSpacing="7"
                                      IsEnabled="{Binding CanUseChapterSearch}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TextBox MinHeight="28"
                                                 Padding="8,4"
                                                 FontSize="11"
                                                 PlaceholderText="Search by chapter title or number…"
                                                 AutomationProperties.Name="Search chapters by title or number"
                                                 Text="{Binding ChapterSearchText, Mode=TwoWay}" />
                                        <Button Grid.Column="1"
                                                Padding="8,4"
                                                FontSize="10"
                                                Content="Clear"
                                                IsVisible="{Binding HasChapterSearchText}"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Command="{Binding ClearChapterSearchCommand}"
                                                AutomationProperties.Name="Clear chapter search" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               FontSize="10"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Text="{Binding ChapterSearchCountText}" />
                                    <Grid Grid.Row="2">
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="No matching chapters. Try a title or number."
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding HasNoChapterSearchResults}" />
                                        <ScrollViewer MaxHeight="160"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto"
                                                      IsVisible="{Binding HasChapterSearchResults}">
                                            <ItemsControl ItemsSource="{Binding ChapterSearchResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ChapterSearchResultViewModel">
                                                        <Button Margin="0,0,0,4"
                                                                Padding="8,7"
                                                                FontSize="11"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Background="{DynamicResource SurfaceAltBrush}"
                                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                                Command="{Binding GoToCommand}"
                                                                ToolTip.Tip="{Binding DisplayText}"
                                                                AutomationProperties.Name="{Binding DisplayText}">
                                                            <TextBlock Text="{Binding DisplayText}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Expander>
                            <TextBlock Grid.Row="3"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding ChapterListeningTimeRemainingText}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasChapterListeningTimeEstimate}"
                                       ToolTip.Tip="Estimated listening time to this chapter's end at the selected speed, excluding pauses." />
                        </Grid>
                    </Border>

                    <Border MaxHeight="260"
                            Padding="11,9"
                            CornerRadius="11"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding CanDisplayBookmarkPanel}">
                        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="7">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="BOOKMARKS" />
                                    <TextBlock FontSize="10"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               IsVisible="{Binding HasBookmarks}"
                                               Text="{Binding BookmarkCountText}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Padding="9,5"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource OnAccentBrush}"
                                        FontSize="10"
                                        Command="{Binding QuickBookmarkCommand}"
                                        Content="+ Quick bookmark"
                                        IsEnabled="{Binding CanCreateBookmark}"
                                        ToolTip.Tip="Save this position immediately without a dialog. Use Edit afterward to add a name or note." />
                                <Button Grid.Column="2"
                                        Padding="9,5"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        FontSize="10"
                                        Command="{Binding AddBookmarkCommand}"
                                        Content="Add with note…"
                                        IsEnabled="{Binding CanCreateBookmark}"
                                        ToolTip.Tip="Open the bookmark editor to add a name or note before saving this position" />
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBox MinHeight="28"
                                         Padding="8,4"
                                         FontSize="11"
                                         PlaceholderText="Search bookmarks by name or note…"
                                         AutomationProperties.Name="Search bookmarks by name or note"
                                         Text="{Binding BookmarkSearchText, Mode=TwoWay}" />
                                <Button Grid.Column="1"
                                        Padding="8,4"
                                        FontSize="10"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Content="Clear"
                                        IsVisible="{Binding HasBookmarkSearchText}"
                                        Command="{Binding ClearBookmarkSearchCommand}"
                                        AutomationProperties.Name="Clear bookmark search"
                                        ToolTip.Tip="Show all bookmarks for this audiobook" />
                            </Grid>

                            <Border Grid.Row="2"
                                    Padding="8,5"
                                    CornerRadius="8"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    IsVisible="{Binding HasDeletedBookmark}">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentSoftTextBrush}"
                                               Text="{Binding DeletedBookmarkText}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding DeletedBookmarkText}" />
                                    <Button Grid.Column="1"
                                            Padding="8,4"
                                            FontSize="10"
                                            Background="{DynamicResource AccentBrush}"
                                            Foreground="{DynamicResource OnAccentBrush}"
                                            Content="Undo"
                                            Command="{Binding UndoBookmarkDeletionCommand}"
                                            AutomationProperties.Name="Undo bookmark deletion"
                                            ToolTip.Tip="Restore the most recently deleted bookmark with its name, note, and position" />
                                    <Button Grid.Column="2"
                                            Padding="8,4"
                                            FontSize="10"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Content="Dismiss"
                                            Command="{Binding DismissBookmarkUndoCommand}"
                                            AutomationProperties.Name="Dismiss bookmark undo"
                                            ToolTip.Tip="Dismiss this Undo option; the bookmark stays deleted" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="3">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           IsVisible="{Binding HasNoBookmarks}"
                                           Text="No bookmarks for this audiobook yet." />

                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           IsVisible="{Binding HasNoMatchingBookmarks}"
                                           Text="No matching bookmarks. Try another name or note."
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />

                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              IsVisible="{Binding HasMatchingBookmarks}"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredBookmarks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PlaybackBookmarkItemViewModel">
                                            <Border Margin="0,0,0,6"
                                                    Padding="9,7"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource SurfaceAltBrush}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   Text="{Binding NameText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                                   Text="{Binding LocationText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock MaxHeight="34"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   IsVisible="{Binding HasNote}"
                                                                   Text="{Binding NoteText}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal"
                                                                Spacing="5">
                                                        <Button Padding="9,5"
                                                                Background="{DynamicResource AccentBrush}"
                                                                Foreground="{DynamicResource OnAccentBrush}"
                                                                FontSize="10"
                                                                Command="{Binding JumpCommand}"
                                                                Content="Jump" />
                                                        <Button Padding="9,5"
                                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                                FontSize="10"
                                                                Command="{Binding EditCommand}"
                                                                Content="Edit" />
                                                        <Button Padding="9,5"
                                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                                Foreground="{DynamicResource DangerTextBrush}"
                                                                FontSize="10"
                                                                Command="{Binding DeleteCommand}"
                                                                Content="Delete" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="14">
                        <Button Width="92"
                                Height="48"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Command="{Binding SkipBackwardCommand}"
                                IsEnabled="{Binding CanControlPlayback}"
                                ToolTip.Tip="{Binding SkipSettings.RewindToolTip}"
                                Content="{Binding SkipSettings.RewindButtonText}" />
                        <Button Width="112"
                                Height="56"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource OnAccentBrush}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Command="{Binding TogglePlaybackCommand}"
                                IsEnabled="{Binding CanControlPlayback}"
                                ToolTip.Tip="Play or pause (Space, K, or Play/Pause media button)"
                                Content="{Binding PlayPauseLabel}" />
                        <Button Width="92"
                                Height="48"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Command="{Binding SkipForwardCommand}"
                                IsEnabled="{Binding CanControlPlayback}"
                                ToolTip.Tip="{Binding SkipSettings.ForwardToolTip}"
                                Content="{Binding SkipSettings.ForwardButtonText}" />
                    </StackPanel>

                    <TextBlock MinHeight="20"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource DangerTextBrush}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,150,*,Auto,90">
                    <Button Grid.Column="0"
                            Margin="0,0,10,0"
                            Padding="6"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            Command="{Binding ToggleMuteCommand}"
                            ToolTip.Tip="{Binding MuteButtonToolTip}"
                            AutomationProperties.Name="{Binding MuteButtonToolTip}">
                        <Grid Width="24" Height="24">
                            <Path Fill="{DynamicResource SecondaryTextBrush}"
                                  Data="M 3,8 L 7,8 L 12,4 L 12,20 L 7,16 L 3,16 Z" />
                            <Path Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.8"
                                  Data="M 15,8 C 18,10 18,14 15,16 M 18,5 C 23,9 23,15 18,19"
                                  IsVisible="{Binding IsVolumeAudible}" />
                            <Path Stroke="{DynamicResource AccentTextBrush}"
                                  StrokeThickness="2"
                                  Data="M 16,9 L 22,15 M 22,9 L 16,15"
                                  IsVisible="{Binding IsMuted}" />
                        </Grid>
                    </Button>
                    <Slider Grid.Column="1"
                            Minimum="0"
                            Maximum="100"
                            AutomationProperties.Name="Volume"
                            Value="{Binding Volume, Mode=TwoWay}" />

                    <TextBlock Grid.Column="3"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Speed" />
                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding PlaybackRates}"
                              SelectedItem="{Binding SelectedPlaybackRate, Mode=TwoWay}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
