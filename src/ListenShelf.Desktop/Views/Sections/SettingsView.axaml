<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ListenShelf.Desktop.ViewModels"
             x:Class="ListenShelf.Desktop.Views.Sections.SettingsView"
             x:DataType="vm:MainWindowViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="850"
                    HorizontalAlignment="Left"
                    Spacing="24">
            <StackPanel Spacing="10">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="Appearance" />
                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Choose the look that is most comfortable for you."
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="18"
                        CornerRadius="15"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,24,0"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="Color mode" />
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="The choice applies immediately and is remembered next time."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="10">
                            <Button MinWidth="106"
                                    Padding="14,10"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Command="{Binding UseDarkThemeCommand}">
                                <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
                                    <Border Width="14"
                                            Height="14"
                                            CornerRadius="7"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1.5">
                                        <Border Margin="3"
                                                CornerRadius="4"
                                                Background="{DynamicResource AccentBrush}"
                                                IsVisible="{Binding IsDarkThemeSelected}" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="Dark" />
                                </Grid>
                            </Button>

                            <Button MinWidth="106"
                                    Padding="14,10"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Command="{Binding UseLightThemeCommand}">
                                <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
                                    <Border Width="14"
                                            Height="14"
                                            CornerRadius="7"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1.5">
                                        <Border Margin="3"
                                                CornerRadius="4"
                                                Background="{DynamicResource AccentBrush}"
                                                IsVisible="{Binding IsLightThemeSelected}" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="Light" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   FontSize="11"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   Text="{Binding AppearanceSettingsMessage}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="Library storage" />
                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="ListenShelf keeps organized, verified copies while leaving your original files untouched."
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="17"
                        CornerRadius="13"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="5">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="MANAGED LIBRARY LOCATION" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding ManagedLibraryPath}"
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="Audiobooks added to ListenShelf are copied here and verified before being added to your shelf. Original source files are left untouched."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Padding="17"
                        CornerRadius="13"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="Storage care" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="Checks, orphan recovery, and confirmed cleanup now live in their own quiet area. An exclamation mark appears there only when something needs attention."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                MinWidth="126"
                                Padding="14,8"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Command="{Binding ShowStorageCareCommand}"
                                Content="Open storage care" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="Local backup and restore" />
                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Keep your complete ListenShelf library in one portable backup file. Cloud storage can use the same format later."
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="18"
                        CornerRadius="15"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="ListenShelf backup file" />
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="Includes the catalog database, managed audiobooks, covers, settings, bookmarks, listening progress, and any recoverable orphaned storage. Audio is stored without wasteful recompression."
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="9">
                                <Button MinWidth="124"
                                        Padding="14,9"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource OnAccentBrush}"
                                        FontWeight="SemiBold"
                                        Command="{Binding ExportBackupCommand}"
                                        Content="Export backup" />
                                <Button MinWidth="148"
                                        Padding="14,9"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Command="{Binding ChooseBackupToRestoreCommand}"
                                        Content="Restore from backup" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" />

                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding BackupStatusText}"
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="Backup files are not encrypted. Store them somewhere you trust. ListenShelf does not upload them."
                                   TextWrapping="Wrap" />

                        <StackPanel Spacing="5" IsVisible="{Binding IsBackupProgressVisible}">
                            <ProgressBar Height="7"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding BackupProgressPercentage}" />
                            <TextBlock FontSize="10"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="{Binding BackupProgressText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Padding="14"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource CoralAccentBrush}"
                                BorderThickness="1"
                                IsVisible="{Binding IsRestoreConfirmationVisible}">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerTextBrush}"
                                           Text="CONFIRM FULL LIBRARY RESTORE" />
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{Binding PendingRestoreSummaryText}"
                                           TextWrapping="Wrap" />
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding PendingRestorePath}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding PendingRestorePath}" />
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="This replaces the current catalog, managed books, covers, settings, bookmarks, and progress. Before replacement, ListenShelf will automatically save the current library as another backup beside the selected file."
                                           TextWrapping="Wrap" />
                                <StackPanel HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="9">
                                    <Button MinWidth="90"
                                            Padding="13,8"
                                            Background="{DynamicResource SurfaceBrush}"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Command="{Binding CancelSelectedBackupRestoreCommand}"
                                            Content="Cancel" />
                                    <Button MinWidth="146"
                                            Padding="13,8"
                                            Background="{DynamicResource CoralAccentBrush}"
                                            Foreground="{DynamicResource OnAccentBrush}"
                                            FontWeight="SemiBold"
                                            Command="{Binding RestoreSelectedBackupCommand}"
                                            Content="Restore library" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
