<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ListenShelf.Desktop.ViewModels"
             x:Class="ListenShelf.Desktop.Views.Sections.SettingsView"
             x:DataType="vm:MainWindowViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="850"
                    HorizontalAlignment="Left"
                    Spacing="24">
            <StackPanel Spacing="10">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="Appearance" />
                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Choose the look that is most comfortable for you."
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="18"
                        CornerRadius="15"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,24,0"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="Color mode" />
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="The choice applies immediately and is remembered next time."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="10">
                            <Button MinWidth="106"
                                    Padding="14,10"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Command="{Binding UseDarkThemeCommand}">
                                <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
                                    <Border Width="14"
                                            Height="14"
                                            CornerRadius="7"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1.5">
                                        <Border Margin="3"
                                                CornerRadius="4"
                                                Background="{DynamicResource AccentBrush}"
                                                IsVisible="{Binding IsDarkThemeSelected}" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="Dark" />
                                </Grid>
                            </Button>

                            <Button MinWidth="106"
                                    Padding="14,10"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Command="{Binding UseLightThemeCommand}">
                                <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
                                    <Border Width="14"
                                            Height="14"
                                            CornerRadius="7"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1.5">
                                        <Border Margin="3"
                                                CornerRadius="4"
                                                Background="{DynamicResource AccentBrush}"
                                                IsVisible="{Binding IsLightThemeSelected}" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="Light" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   FontSize="11"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   Text="{Binding AppearanceSettingsMessage}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="Library storage" />
                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="ListenShelf keeps organized, verified copies while leaving your original files untouched."
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="17"
                        CornerRadius="13"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="5">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="MANAGED LIBRARY LOCATION" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding ManagedLibraryPath}"
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="Audiobooks added to ListenShelf are copied here and verified before being added to your shelf. Original source files are left untouched."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Padding="17"
                        CornerRadius="13"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="Managed storage integrity" />
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="Read-only check for missing, unreferenced, and stale import files."
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    MinWidth="104"
                                    Padding="14,8"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Command="{Binding CheckManagedStorageCommand}"
                                    Content="Check now"
                                    IsEnabled="{Binding CanCheckManagedStorage}" />
                        </Grid>

                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding ManagedStorageStatusText}"
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding ManagedStorageLastCheckedText}" />

                        <Border Padding="11,8"
                                CornerRadius="8"
                                Background="{DynamicResource AccentSoftBrush}"
                                IsVisible="{Binding IsManagedStorageHealthy}">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentSoftTextBrush}"
                                       Text="Storage check passed" />
                        </Border>

                        <StackPanel Spacing="8"
                                    IsVisible="{Binding HasManagedStorageIssues}">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerTextBrush}"
                                       Text="REVIEW DETECTED ITEMS" />
                            <ItemsControl ItemsSource="{Binding ManagedStorageIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ManagedStorageIssueItemViewModel">
                                        <Border Margin="0,0,0,7"
                                                Padding="11"
                                                CornerRadius="9"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource DangerTextBrush}"
                                                           Text="{Binding Category}" />
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding Description}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock FontSize="10"
                                                           Foreground="{DynamicResource SubtleTextBrush}"
                                                           Text="{Binding Path}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Path}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
