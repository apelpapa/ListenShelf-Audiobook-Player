<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ListenShelf.Desktop.ViewModels"
             x:Class="ListenShelf.Desktop.Views.Sections.StorageCareView"
             x:DataType="vm:MainWindowViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900"
                    HorizontalAlignment="Stretch"
                    Spacing="14">
            <Border Padding="18"
                    CornerRadius="13"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="Managed storage check" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="ListenShelf quietly checks for missing, unreferenced, and unfinished managed files. It never cleans anything up automatically."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                MinWidth="104"
                                Padding="14,8"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Command="{Binding CheckManagedStorageCommand}"
                                Content="Check now"
                                IsEnabled="{Binding CanCheckManagedStorage}" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource SeparatorBrush}" />

                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding ManagedStorageStatusText}"
                               TextWrapping="Wrap" />
                    <TextBlock FontSize="10"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding ManagedStorageLastCheckedText}" />

                    <Border Padding="11,8"
                            CornerRadius="8"
                            Background="{DynamicResource AccentSoftBrush}"
                            IsVisible="{Binding IsManagedStorageHealthy}">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentSoftTextBrush}"
                                   Text="Everything in managed storage is accounted for" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Padding="15,12"
                    CornerRadius="11"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    IsVisible="{Binding HasManagedStorageIssues}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                    <Border Grid.Column="0"
                            Width="26"
                            Height="26"
                            CornerRadius="13"
                            Background="{DynamicResource WarmAccentBrush}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentBrush}"
                                   Text="!" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="{Binding ManagedStorageAttentionText}" />
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Orphans are harmless to your catalog and only use disk space. Recover anything useful, or choose cleanup and confirm it inline when you no longer need it."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding ManagedStorageIssues}"
                          IsVisible="{Binding HasManagedStorageIssues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ManagedStorageIssueItemViewModel">
                        <Border Margin="0,0,0,9"
                                Padding="15"
                                CornerRadius="11"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DangerTextBrush}"
                                                   Text="{Binding Category}" />
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                IsVisible="{Binding ShowPrimaryActions}">
                                        <Button MinWidth="90"
                                                Padding="13,7"
                                                Background="{DynamicResource AccentBrush}"
                                                Foreground="{DynamicResource OnAccentBrush}"
                                                FontWeight="SemiBold"
                                                Command="{Binding RecoverCommand}"
                                                Content="Recover"
                                                IsVisible="{Binding CanRecover}" />
                                        <Button MinWidth="90"
                                                Padding="13,7"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Command="{Binding RequestCleanupCommand}"
                                                Content="Clean up"
                                                IsVisible="{Binding CanCleanUp}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding Description}"
                                           TextWrapping="Wrap" />
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding Path}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Path}" />
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{Binding ActionHint}"
                                           TextWrapping="Wrap" />

                                <Border Padding="12"
                                        CornerRadius="9"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource CoralAccentBrush}"
                                        BorderThickness="1"
                                        IsVisible="{Binding IsCleanupConfirmationVisible}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DangerTextBrush}"
                                                       Text="CONFIRM PERMANENT CLEANUP" />
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="{Binding CleanupPrompt}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                            <Button Padding="12,7"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                    Command="{Binding CancelCleanupCommand}"
                                                    Content="Cancel" />
                                            <Button MinWidth="100"
                                                    Padding="12,7"
                                                    Background="{DynamicResource CoralAccentBrush}"
                                                    Foreground="{DynamicResource OnAccentBrush}"
                                                    FontWeight="SemiBold"
                                                    Command="{Binding ConfirmCleanupCommand}"
                                                    Content="{Binding CleanupButtonText}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
