<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ListenShelf.Desktop.ViewModels"
             x:Class="ListenShelf.Desktop.Views.Components.LibraryImportPanel"
             x:DataType="vm:LibraryImportViewModel"
             IsVisible="{Binding IsVisible}">
    <Border Padding="16" CornerRadius="13"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Text="{Binding StatusText}" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel import" Command="{Binding CancelCommand}"
                            IsVisible="{Binding IsRunning}" Padding="12,6"
                            ToolTip.Tip="Stop unfinished imports. Completed books stay in your library; originals are untouched." />
                    <Button Content="Dismiss" Command="{Binding DismissCommand}"
                            IsVisible="{Binding CanDismiss}" Padding="12,6" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="7" IsVisible="{Binding IsRunning}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding CurrentFileName}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding CurrentFileName}" />
                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding BookNumberText}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock FontSize="11" Foreground="{DynamicResource AccentTextBrush}"
                               Text="{Binding StageText}" />
                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding ByteProgressText}" />
                </Grid>
                <ProgressBar Height="8" Minimum="0" Maximum="100"
                             Value="{Binding StagePercentage}" IsIndeterminate="{Binding IsStageIndeterminate}"
                             AutomationProperties.Name="Current copy or verification progress" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,3,0,0">
                    <TextBlock VerticalAlignment="Center" FontSize="10" Text="OVERALL"
                               Foreground="{DynamicResource SubtleTextBrush}" />
                    <ProgressBar Grid.Column="1" Height="5" Minimum="0" Maximum="100"
                                 Value="{Binding OverallPercentage}"
                                 AutomationProperties.Name="Overall import progress" />
                </Grid>
            </StackPanel>

            <Expander Header="Import details" IsVisible="{Binding HasResults}"
                      IsExpanded="{Binding AreDetailsExpanded, Mode=TwoWay}"
                      HorizontalContentAlignment="Stretch">
                <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryImportItemViewModel">
                                <Border Padding="0,6" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource BorderBrush}">
                                    <StackPanel Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"
                                                       Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding FilePath}" />
                                            <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       Text="{Binding StatusText}" />
                                        </Grid>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="{Binding Detail}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
